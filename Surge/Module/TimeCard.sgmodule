#!name=节假日倒计时
#!desc=通过panel显示节假日倒计时，节日当天早上有提醒。by @smartmimi
#!category=zqzess

[Script]
节假日倒计时 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/synchen232/rule_for_quantumultX/master/Surge/Script/TimeCard/TimeCard.js

[Panel]
节假日倒计时 = script-name=节假日倒计时,update-interval=3600

